rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'emmanuelagbanyo8@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Account Rules: Only Admins can modify account data. Everyone authenticated can read.
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Investor Rules: Admins can manage all. Investors can read their own.
    match /investors/{investorId} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Transaction Rules: Admins can manage all. Investors can read their own.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (isAdmin() || 
        (resource != null && get(/databases/$(database)/documents/investors/$(resource.data.investorId)).data.uid == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Portfolio Rules: Only Admins can modify.
    match /portfolio/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Valuation Rules
    match /valuations/{valuationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reverted_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /asset_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reverted_asset_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Roles & Profile Settings
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }
  }
}
