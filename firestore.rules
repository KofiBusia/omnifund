rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userExists() && userDoc().role == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && userExists() && userDoc().role in ['admin', 'superadmin'];
    }

    function isStaff() {
      return isSignedIn() && userExists() && userDoc().role in ['admin', 'superadmin', 'staff', 'support'];
    }

    function isInvestorOwner() {
      return isSignedIn() && (
        resource != null && resource.data.uid == request.auth.uid
      );
    }

    // ── Default deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Fund Accounts ────────────────────────────────────────────────
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      // Staff can create/update accounts; bulk upload updates totalUnits & cashBalance
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Investors ─────────────────────────────────────────────────────
    match /investors/{investorId} {
      allow read: if isSignedIn() && (isStaff() || isInvestorOwner());
      // Any signed-in user can create (covers bulk upload creating new investors)
      allow create: if isSignedIn();
      // Staff or the investor themselves can update their own profile
      allow update: if isSignedIn() && (isStaff() || isInvestorOwner());
      allow delete: if isAdmin();
    }

    // ── Transactions ─────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (isStaff() ||
        (resource != null &&
         get(/databases/$(database)/documents/investors/$(resource.data.investorId)).data.uid == request.auth.uid));
      // Any signed-in user can create (covers bulk upload posting subscriptions)
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // ── Unit Movement Ledger ─────────────────────────────────────────
    // Written by bulk upload engine on every subscription/redemption
    match /unit_ledger/{ledgerId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Portfolio Assets ─────────────────────────────────────────────
    match /portfolio/{assetId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ── Valuations ───────────────────────────────────────────────────
    match /valuations/{valuationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /reverted_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /asset_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /reverted_asset_valuations/{valId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ── Portal Invitations ───────────────────────────────────────────
    // Written by bulk upload portal provisioning phase
    match /portal_invitations/{invId} {
      allow read: if isStaff() || (isSignedIn() && resource != null && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isStaff() || (resource != null && resource.data.email == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // ── Portal Invitation Audit Logs ─────────────────────────────────
    match /portal_invitation_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Support Tickets ──────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (isStaff() ||
        (resource != null && (resource.data.investorUid == request.auth.uid || resource.data.createdBy == request.auth.uid)));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isStaff() ||
        (resource != null && (resource.data.investorUid == request.auth.uid || resource.data.createdBy == request.auth.uid)));
      allow delete: if isAdmin();
    }

    // ── User Profiles ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      // Self-registration may only claim 'admin' or 'investor' (the roles the Login UI offers) —
      // never 'superadmin'/'staff'/'support'.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['admin', 'investor'];
      // Users may update their own profile but not their own role — role changes (including
      // promotions to staff/support/superadmin) require an existing admin.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Batch Import Audit Records ───────────────────────────────────
    match /import_batches/{batchId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

  }
}
